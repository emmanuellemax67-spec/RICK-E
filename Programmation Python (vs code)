    {"question": "Tu as 3 bonbons et tu en gagnes 2. Combien en as-tu ?", "reponses": ["5", "cinq"], "bonne_reponse": "5", "explication": "3 plus 2 font 5."}
]


# ==================================================
# VÉRIFICATION DES RÉPONSES
# ==================================================

def verifier_reponse(reponse, question):
    reponse = nettoyer_reponse(reponse)

    for bonne_reponse in question["reponses"]:
        bonne_reponse = nettoyer_reponse(bonne_reponse)

        if bonne_reponse in reponse:
            parler(
                "Correct ! "
                + random.choice([
                    "Tu m'impressionnes presque.",
                    "Pas mal pour un humain.",
                    "Bonne réponse.",
                    "Je savais que tu pouvais y arriver.",
                    "Ton cerveau fonctionne finalement."
                ])
                + " "
                + question["explication"]
            )

            # Bonne réponse : on déclenche la distribution de sucette
            # (refusée automatiquement par l'Arduino si le servo est
            # déjà verrouillé, ou si moins de 5 s se sont écoulées
            # depuis la dernière distribution).
            envoyer_commande_dispense()

            return True

    parler(
        "Faux ! "
        + random.choice([
            "Il va falloir réviser.",
            "Même ma mémoire défectueuse connaissait la réponse.",
            "Essaie de faire fonctionner ton cerveau.",
            "C'était pourtant facile.",
            "Tu peux mieux faire."
        ])
        + " La bonne réponse était "
        + question["bonne_reponse"]
        + ". "
        + question["explication"]
    )

    # Mauvaise réponse : la LED rouge clignote sur l'Arduino
    envoyer_commande_erreur()

    return False


# ==================================================
# INTERACTION AVEC L'UTILISATEUR
# ==================================================

def interaction():
    parler("Bienvenue humain ! Moi c'est Riki, le gardien officiel des bonbons.")
    parler("Tu veux un bonbon ? Évidemment que tu en veux un.")
    parler("Mais il va falloir le mériter.")
    parler("Je vais te poser 3 énigmes. Chaque bonne réponse peut te faire gagner une sucette.")
    parler("Dis bonjour pour commencer le défi.")

    reponse = ecouter()
    if "bonjour" in reponse or "salut" in reponse:
        parler("Bonjour humain ! Première épreuve réussie.")
    else:
        parler("Bon, ce n'était pas vraiment bonjour, mais on commence quand même.")

    score = 0
    questions_du_quiz = random.sample(questions, 3)

    for numero, question in enumerate(questions_du_quiz, start=1):
        parler(f"Énigme numéro {numero}.")
        parler(question["question"])
        reponse = ecouter()

        if reponse and verifier_reponse(reponse, question):
            score += 1
        elif not reponse:
            parler("Je n'ai pas entendu ta réponse. La bonne réponse était " + question["bonne_reponse"] + ".")
            envoyer_commande_erreur()

        time.sleep(1)

    parler(f"Défi terminé ! Tu as obtenu {score} bonnes réponses sur 3.")
    if score == 3:
        parler("Impressionnant ! Tu as réussi toutes les énigmes. Bravo humain !")
    elif score > 0:
        parler("Pas mal ! Continue de réfléchir et tu deviendras peut-être aussi intelligent que moi.")
    else:
        parler("Aucune bonne réponse. Il va falloir réviser, humain.")

    parler("Merci d'avoir joué avec Riki. À bientôt !")


# ==================================================
# LANCEMENT DU PROGRAMME
# ==================================================

if __name__ == "__main__":
    connecter_arduino()
    interaction()
