    {"question": "Quelle est la planète la plus proche du Soleil ?", "reponses": ["mercure"], "bonne_reponse": "Mercure", "explication": "Mercure est la planète la plus proche du Soleil."},
    {"question": "J'ai trois côtés et trois angles. Qui suis-je ?", "reponses": ["triangle", "un triangle"], "bonne_reponse": "un triangle", "explication": "Un triangle possède trois côtés et trois angles."},
